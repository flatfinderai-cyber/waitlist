{
  "name": "FlatFinder Automator (Python 3.12)",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefault": true
    }
  },
  "postCreateCommand": "pip install reflex pydantic python-dotenv requests supabase bandit PyYAML && bash setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [3000, 8000],
  "remoteUser": "vscode"
}
